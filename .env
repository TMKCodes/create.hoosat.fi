# Server settings, read by src/server/index.tsx with dotenv.
PROTOCOL="HTTP"
PORT="8181"
# For PROTOCOL="HTTPS" also set the certificate paths:
# HTTPS_KEY="/etc/ssl/private/create.hoosat.fi.key"
# HTTPS_CERT="/etc/ssl/certs/create.hoosat.fi.crt"

# Daily dependency update check, see README "Dependency updates". Put SMTP_USER and SMTP_PASS in the
# server's environment (docker --env-file), never in this file: it is committed.
# DEPENDENCY_CHECK_EMAIL=toni.lukkaroinen@hoosat.fi
# SMTP_HOST=127.0.0.1
# SMTP_PORT=587
